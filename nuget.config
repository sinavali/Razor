<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Public nuget.org for .NET BCL packages -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Gitea internal feed for Kernel (consumed by Engine within same build) -->
    <add key="Gitea" value="https://your-gitea-domain/api/packages/Chronos/nuget/index.json" protocolVersion="3" />
  </packageSources>
</configuration>